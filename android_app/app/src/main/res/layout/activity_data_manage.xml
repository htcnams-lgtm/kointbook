<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/body_bg">

    <include layout="@layout/title_bar" />

    <!-- [2026-09-30] "DATA관리 화면 상단 PC 미전송 데이터 [N건] 글자,숫자
         크기 2사이즈 크게 굵게 검은색으로" - 15sp -> 17sp, 검은색 명시. -->
    <TextView
        android:id="@+id/tvUnsentHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="14dp"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="#000000"
        android:text="PC 미전송 데이터 [0건]" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- [2026-09-30] "PDA DATA 관리 모든 버튼 글자 크기를 2사이즈 크고
             굵게" - 기본 크기(약 14sp)에서 16sp로, 굵게 추가. -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_classic"
            android:elevation="2dp"
            android:textColor="#FFFFFF"
            android:text="1. Data 전송"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnQuery"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_classic"
            android:elevation="2dp"
            android:textColor="#FFFFFF"
            android:text="2. DATA 조회"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSectionQuery"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_classic"
            android:elevation="2dp"
            android:textColor="#FFFFFF"
            android:text="3. 위치별 건수/수량 조회"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUnsentCheck"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_classic"
            android:elevation="2dp"
            android:textColor="#FFFFFF"
            android:text="4. 미전송 확인"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
