<?xml version="1.0" encoding="utf-8"?>
<!-- [2026-09-23 5차 정정] TextInputLayout(플로팅 라벨) 방식은 힌트 문구가
     입력칸 "위쪽"에 별도 줄로 뜨는 모양이 되어(예전 클래식 박스 느낌과
     달라짐), 값이 있든 없든 힌트가 입력칸 "안쪽"에 그대로 보이도록
     FrameLayout으로 다시 짰다:
       - 배경(edit_classic 테두리 박스)은 FrameLayout에 그대로 씀 - 이
         드로어블은 이미 state_focused일 때 초록 테두리(focus_green)로
         바뀌게 되어 있는데, 포커스는 안에 있는 EditText가 받으므로
         FrameLayout에 android:addStatesFromChildren="true"를 줘서 자식
         (EditText)이 포커스를 받으면 FrameLayout 배경도 그 상태를 그대로
         물려받아 초록 테두리가 보이게 했다.
       - 박스 위쪽에 실제 입력값(EditText, 배경 투명)
       - 박스 아래쪽에 작은 힌트 텍스트(항상 표시, 안 사라짐)
     힌트와 입력값이 위/아래로 나뉘어 있어 서가번호(최대 20자리)처럼 값이
     길어져도 서로 겹치지 않는다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/body_bg">

    <include layout="@layout/title_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 1. AREA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="0dp">

            <TextView
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:text="AREA"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/edit_classic"
                android:addStatesFromChildren="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="7dp">

                <EditText
                    android:id="@+id/etArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="@null"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:maxLength="2"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@+id/etSection"
                    android:textColor="#000000"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:text="스캔 또는 입력(2자리)"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary" />
            </FrameLayout>
        </LinearLayout>

        <!-- 2. SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:text="SECTION"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/edit_classic"
                android:addStatesFromChildren="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="7dp">

                <EditText
                    android:id="@+id/etSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="@null"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:maxLength="3"
                    android:imeOptions="actionNext"
                    android:nextFocusUp="@+id/etArea"
                    android:nextFocusDown="@+id/etShelfNo"
                    android:textColor="#000000"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:text="스캔 또는 입력(3자리)"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary" />
            </FrameLayout>
        </LinearLayout>

        <!-- 서가번호 자리 안내: 문구 AREA일 때만 보임(서가번호 줄이 숨겨진 빈 공간) -->
        <TextView
            android:id="@+id/tvStationeryNote"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/box_green_note"
            android:gravity="center"
            android:padding="0dp"
            android:text="문구로 입력됩니다."
            android:textStyle="bold"
            android:textColor="@color/focus_green"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- 3. 서가번호 (문구 모드에서는 숨김) -->
        <LinearLayout
            android:id="@+id/rowShelf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:text="서가번호"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/edit_classic"
                android:addStatesFromChildren="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="7dp">

                <EditText
                    android:id="@+id/etShelfNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="@null"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:maxLength="20"
                    android:imeOptions="actionDone"
                    android:nextFocusUp="@+id/etSection"
                    android:textColor="#000000"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:text="스캔 또는 입력(20자리 이하)"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary" />
            </FrameLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <!-- [2026-10-15] 사용 가능한 AREA 안내 상자(사용자 선택 C안). 값은 AppState.AREA_RULE_TEXT와 같다. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:background="@drawable/box_yellow"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="사용 가능한 AREA"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="서적"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10~19, 90~99"
                    android:textColor="#000000"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="문구"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20~29, 80~89"
                    android:textColor="#000000"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="서가번호 없음"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMaxQty"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="@drawable/button_classic"
            android:elevation="2dp"
            android:textColor="#FFFFFF"
            android:text="Max수량설정"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

</LinearLayout>
