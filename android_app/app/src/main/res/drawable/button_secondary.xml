<?xml version="1.0" encoding="utf-8"?>
<!-- 보조 버튼: 테두리만 있는 아웃라인 스타일. 포커스 시 진한 초록 테두리 표시 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/bg_surface_alt" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/bg_main" />
            <stroke android:width="3dp" android:color="@color/focus_green" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/bg_main" />
            <stroke android:width="1.5dp" android:color="@color/border_subtle" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
