<?xml version="1.0" encoding="utf-8"?>
<!-- 기본(강조) 버튼: 진한 남색 채움 + 각진 모서리(Windows 11 스타일) + 옅은 테두리. 포커스 시 진한 초록 테두리 표시 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#D3D6E0" />
            <stroke android:width="1dp" android:color="@color/button_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/accent_pressed" />
            <stroke android:width="1dp" android:color="@color/accent_button_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/accent" />
            <stroke android:width="3dp" android:color="@color/focus_green" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/accent" />
            <stroke android:width="1dp" android:color="@color/accent_button_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
